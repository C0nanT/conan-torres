{
  "name": "conan-torres",
  "version": "0.1.0",
  "private": true,
  "author": "Conan Torres",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/C0nanT/conantorres.dev"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,mdx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "geist": "^1.7.2",
    "lucide-react": "^0.279.0",
    "next": "^15.5.28",
    "next-intl": "^4.14.9",
    "pdfjs-dist": "5.4.296",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-icons": "^5.7.0",
    "react-pdf": "10.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.1",
      "sharp@<0.35.5": "^0.35.5",
      "postcss@<8.5.23": "^8.5.23",
      "picomatch@<2.3.2": "^2.3.2",
      "yaml@>=2 <2.8.3": "^2.8.3",
      "postcss-selector-parser@<6.1.5": "^6.1.5"
    }
  }
}
