# Copie para .env (nunca commitado) e preencha. Só o leitor de livros e a
# página de manutenção usam variáveis; sem elas, o resto do site funciona.

# Ambiente: "production" na VPS (página de manutenção em /about e
# /projects), "development" no localhost. Ausente: igual a development.
APP_ENV=development

# Senha do leitor em /books/<id>/ler. Vazia ou ausente: o leitor recusa o
# acesso. Trocar a senha invalida os cookies de acesso já emitidos.
READER_PASSWORD=

# ID do arquivo no Google Drive de cada livro com "Ler" (compartilhado como
# "qualquer pessoa com o link"): BOOK_FILE_<ID_DO_LIVRO_EM_MAIUSCULAS_COM_
# UNDERSCORE>. Só o ID, nunca o link. Um por livro com `readable` no site.json.
BOOK_FILE_MONOLITO_PARA_MICROSSERVICOS=

# Pasta do banco SQLite do leitor (página salva). Só para rodar fora
# do Docker: a imagem já define /app/reader-data (o volume). Ausente: usa
# ./data-local, ignorada pelo git.
# DATA_DIR=

# Só na VPS (docker-compose.prod.yml): tag da imagem do GHCR. Ausente:
# latest. Use o SHA de um commit para fixar ou voltar uma versão.
# IMAGE_TAG=
